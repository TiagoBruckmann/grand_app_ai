{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter --version)",
      "Bash(flutter doctor:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter pub deps:*)",
      "Bash(flutter pub outdated:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart fix --dry-run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)"
    ],
    "ask": [
      "Bash(flutter pub add:*)",
      "Bash(flutter pub remove:*)",
      "Bash(flutter pub upgrade:*)",
      "Bash(dart fix --apply:*)",
      "Bash(flutter run:*)",
      "Bash(flutter clean:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Edit(analysis_options.yaml)",
      "Edit(pubspec.yaml)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/key.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)"
    ]
  },
  "enabledMcpjsonServers": ["dart"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dart \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_and_analyze.dart\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
